page {
  background: #fcf8f0;
  color: #29231d;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.7;
}
.page { padding: 32rpx 28rpx 72rpx; }
.card {
  background: #fffdf8;
  border: 1rpx solid #e6d9c7;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}
.eyebrow { font-size: 23rpx; color: #a65334; letter-spacing: 2rpx; }
.h1 { font-size: 44rpx; font-weight: 600; line-height: 1.45; }
.h2 { font-size: 32rpx; font-weight: 600; margin-bottom: 10rpx; }
.muted { color: #8a7c6d; font-size: 25rpx; }
.accent { color: #a65334; }
.btn {
  display: flex; align-items: center; justify-content: center;
  border-radius: 999rpx; padding: 22rpx 30rpx; font-size: 29rpx;
  line-height: 1.4; text-align: center;
}
.btn-primary { background: #a65334; color: #fffdf8; }
.btn-outline { background: #fffdf8; color: #a65334; border: 2rpx solid #d9b79f; }
.btn-plain { background: #f4e8dc; color: #6e6257; }
.btn-block { width: 100%; }
.hr { height: 1rpx; background: #e6d9c7; margin: 24rpx 0; }
.state { padding: 60rpx 0; text-align: center; color: #8a7c6d; }
