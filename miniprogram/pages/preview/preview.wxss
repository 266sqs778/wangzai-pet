.card { display: flex; flex-direction: column; }
.summary { align-items: center; text-align: center; }
.summary-name { font-size: 44rpx; font-weight: 600; margin: 8rpx 0 4rpx; }
.preview-image { width: 280rpx; height: 280rpx; margin-top: 10rpx; }
.link {
  display: block; background: #f4e8dc; border-radius: 16rpx;
  padding: 18rpx; margin: 16rpx 0 22rpx;
  font-size: 22rpx; color: #6e6257; word-break: break-all; line-height: 1.6;
}
.second { margin-top: 16rpx; }
.step { display: flex; align-items: flex-start; margin-top: 16rpx; }
.step-num {
  width: 44rpx; height: 44rpx; flex: none; border-radius: 50%;
  background: #f7e3d4; color: #a65334;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; margin-right: 16rpx;
}
.step-text { flex: 1; font-size: 26rpx; color: #6e6257; }
.share-btn { margin-top: 24rpx; border: none; }
.share-btn::after { border: none; }
