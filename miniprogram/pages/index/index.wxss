.hero {
  text-align: center;
  padding: 24rpx 10rpx 40rpx;
}
.hero-title {
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.45;
  margin: 16rpx 0 6rpx;
}
.hero-pet {
  height: 300rpx;
  margin: 8rpx auto 0;
  display: flex;
  justify-content: center;
}
.hero-pet image { width: 300rpx; height: 300rpx; }
.hero-sub { display: block; font-size: 27rpx; color: #6e6257; }
.hero-note { display: block; font-size: 23rpx; color: #9a8b79; margin-top: 6rpx; }
.entry {
  display: flex;
  align-items: center;
  background: #fffdf8;
  border: 1rpx solid #e6d9c7;
  border-radius: 26rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
}
.entry-icon {
  width: 72rpx; height: 72rpx; flex: none;
  border-radius: 20rpx;
  background: #f7e3d4; color: #a65334;
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; margin-right: 22rpx;
}
.entry-body { flex: 1; display: flex; flex-direction: column; }
.entry-title { font-size: 30rpx; font-weight: 600; }
.entry-desc { font-size: 23rpx; color: #8a7c6d; }
.entry-arrow { font-size: 40rpx; color: #c2b2a0; }
.note-card { display: flex; flex-direction: column; }
.note-card .muted { margin-top: 10rpx; }
