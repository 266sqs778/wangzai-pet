.card { display: flex; flex-direction: column; }
.card .h2 { margin-bottom: 6rpx; }
.card .muted { margin-bottom: 14rpx; }
.species-grid { display: flex; flex-wrap: wrap; margin-top: 8rpx; }
.species {
  width: 150rpx; padding: 18rpx 0; margin: 0 12rpx 14rpx 0;
  border: 2rpx solid #e6d9c7; border-radius: 20rpx;
  display: flex; flex-direction: column; align-items: center;
  background: #fffaf1;
}
.species.active { border-color: #a65334; background: #f7e3d4; }
.species-emoji { font-size: 40rpx; line-height: 1.3; }
.species-label { font-size: 23rpx; color: #6e6257; }
.input {
  background: #fffaf1; border: 1rpx solid #e6d9c7; border-radius: 16rpx;
  padding: 16rpx 20rpx; margin-top: 10rpx; font-size: 28rpx;
}
.slider-row { margin-top: 14rpx; }
.slider-label { font-size: 25rpx; color: #6e6257; }
.slider-row slider { margin: 4rpx 0 0; }
.switch-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 16rpx; font-size: 26rpx; color: #6e6257;
}
.line-row { display: flex; align-items: center; margin-top: 12rpx; }
.line-input { flex: 1; margin-top: 0; }
.add-btn { width: 140rpx; margin-left: 12rpx; padding: 14rpx 0; font-size: 25rpx; }
.chips { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.chip {
  font-size: 23rpx; color: #7a5942; background: #f7e3d4;
  border-radius: 999rpx; padding: 8rpx 18rpx; margin: 0 12rpx 12rpx 0;
}
.reset { margin-top: 18rpx; }
